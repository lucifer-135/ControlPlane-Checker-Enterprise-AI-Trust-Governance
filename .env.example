# ====================================================================
# Enterprise AI Trust & Governance Control Plane - Environment Config
# ====================================================================

# GEMINI_API_KEY: (Optional but recommended)
# Required for real-time Gemini LLM Judge tie-breaker evaluation.
# If omitted or unavailable, the system automatically uses deterministic
# heuristic simulation without failing or interrupting traffic.
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Primary production Gemini model (uses stable production tier; avoids preview tags)
GEMINI_MODEL="gemini-3.6-flash"

# LOCAL_JUDGE_MODEL & OLLAMA_BASE_URL:
# Required for local sovereign LLM Judge (zero data egress).
# Runs locally on Ollama (e.g. qwen2.5:7b).
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_JUDGE_MODEL="qwen2.5:7b"
# Ollama request timeout in ms (default: 120000 = 120s for VRAM cold start weights loading)
OLLAMA_TIMEOUT_MS=120000

# PORT: Port on which the Express server and Vite SPA run (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV=development

# APP_URL: The base URL where the application is hosted (e.g., http://localhost:3000)
APP_URL="http://localhost:3000"

# ====================================================================
# Security: authentication, tenancy & event retention
# ====================================================================

# CONTROLPLANE_AUTH_MODE: 'dev' | 'required' (production always uses 'required')
#   dev      - requests without an API key act as a local-dev admin that sees all
#              tenants; the server binds to 127.0.0.1 unless HOST is set.
#   required - every route except /api/health needs "Authorization: Bearer <key>".
CONTROLPLANE_AUTH_MODE=dev

# CONTROLPLANE_BOOTSTRAP_ADMIN_KEY: first admin key registered at startup (>= 24 chars).
# Required to administer a 'required'-mode deployment; the hard-coded demo key
# (cp_live_default_admin_key_2026) is only accepted in 'dev' mode.
CONTROLPLANE_BOOTSTRAP_ADMIN_KEY=""
# Tenant for the bootstrap key (defaults: org_default / ws_production)
# CONTROLPLANE_BOOTSTRAP_ORG_ID=org_default
# CONTROLPLANE_BOOTSTRAP_WORKSPACE_ID=ws_production

# HOST: interface to bind (default: 127.0.0.1 in dev auth mode, 0.0.0.0 otherwise)
# HOST=0.0.0.0

# CONTROLPLANE_DB_PATH: SQLite file (default: ./data/controlplane.db)
# CONTROLPLANE_DB_PATH=./data/controlplane.db

# Gateway event buffer (Live Feed). Payloads are PII-redacted by default;
# 'none' drops prompt/response text entirely ('full' is ignored in production).
CONTROLPLANE_EVENT_PAYLOADS=redacted
CONTROLPLANE_EVENT_TTL_MS=3600000
CONTROLPLANE_EVENT_MAX_PER_ORG=500
CONTROLPLANE_EVENT_MAX_TOTAL=2000
CONTROLPLANE_SSE_MAX_CLIENTS=50

# ====================================================================
# Gateway upstream model fallbacks (comma-separated, per provider)
# A failed model only falls back to models from the SAME provider.
# ====================================================================
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash
# OPENAI_FALLBACK_MODELS=
# ANTHROPIC_FALLBACK_MODELS=
# OLLAMA_FALLBACK_MODELS=
